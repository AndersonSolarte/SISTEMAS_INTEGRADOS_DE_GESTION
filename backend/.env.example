PORT=5000
NODE_ENV=development

DB_HOST=localhost
DB_PORT=5433
DB_NAME=sgc_merge
DB_USER=postgres
DB_PASSWORD=CAMBIAR_DB_PASSWORD

JWT_SECRET=CAMBIAR_JWT_SECRET
JWT_EXPIRE=7d

FRONTEND_URL=http://localhost:3000
# Dominio HTTPS que recibirá los enlaces y QR de firma en producción.
# Ejemplo: PUBLIC_FRONTEND_URL=https://siac.unicesmag.edu.co
PUBLIC_FRONTEND_URL=

# Cloudflare Turnstile. La clave secreta nunca debe enviarse al frontend.
# En desarrollo, si se omite, se utiliza exclusivamente la clave oficial de prueba.
TURNSTILE_SECRET_KEY=

GOOGLE_CLIENT_ID=580702732199-jmeutruntu92d4blhvq28gdfqlucml3p.apps.googleusercontent.com
INSTITUTIONAL_EMAIL_DOMAIN=unicesmag.edu.co
AUTH_GOOGLE_ONLY=true

GOOGLE_SHEETS_ID=CAMBIAR_SHEET_ID_O_URL
GOOGLE_SHEETS_TAB=CAMBIAR_NOMBRE_PESTANA
GOOGLE_SERVICE_ACCOUNT_JSON=keys/google-service-account.json
# Carpeta institucional "REPOSITORIO" donde se creara el nuevo archivo de Planes de Accion.
# Comparta esta carpeta con el correo de la cuenta de servicio y pegue aqui el ID de la URL de Drive.
SIAC_ACTION_REPOSITORY_ROOT_ID=CAMBIAR_ID_CARPETA_REPOSITORIO

# Redireccion de prueba (Modo Sandbox): Si se define, TODOS los correos se redirigen a este buzon.
# EMAIL_SANDBOX_RECIPIENT=adsolarte@unicesmag.edu.co

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=cuenta@dominio.com
SMTP_PASS=CAMBIAR_SMTP_APP_PASSWORD
SMTP_FROM="Sistema SIG <cuenta@dominio.com>"

# Correo exclusivo del flujo de Planes de Accion. No afecta los demas modulos.
PLAN_ACTION_EMAIL_AUTH_METHOD=password
PLAN_ACTION_SMTP_HOST=smtp.gmail.com
PLAN_ACTION_SMTP_PORT=587
PLAN_ACTION_SMTP_SECURE=false
PLAN_ACTION_SMTP_AUTH=true
PLAN_ACTION_SMTP_REQUIRE_TLS=true
PLAN_ACTION_SMTP_USER=planeacionestrategica@unicesmag.edu.co
PLAN_ACTION_SMTP_PASS=CAMBIAR_APP_PASSWORD_PLANEACION
PLAN_ACTION_SMTP_FROM="Planeacion Estrategica UNICESMAG <planeacionestrategica@unicesmag.edu.co>"
PLAN_ACTION_REPLY_TO=planeacionestrategica@unicesmag.edu.co

# Alternativa recomendada cuando Google Workspace bloquea las contrasenas de aplicacion:
# PLAN_ACTION_SMTP_HOST=smtp-relay.gmail.com
# PLAN_ACTION_SMTP_AUTH=false
# PLAN_ACTION_SMTP_PASS=

# Alternativa OAuth 2.0 con Gmail API (recomendada si ya usan Google Auth):
# PLAN_ACTION_EMAIL_AUTH_METHOD=oauth2
# PLAN_ACTION_GOOGLE_CLIENT_ID=
# PLAN_ACTION_GOOGLE_CLIENT_SECRET=
# Genere este token para planeacionestrategica@unicesmag.edu.co con los alcances
# https://www.googleapis.com/auth/gmail.send y https://www.googleapis.com/auth/drive.
# PLAN_ACTION_GOOGLE_REFRESH_TOKEN=

# Alertas automáticas de vigencia del Plan Estratégico de Seguridad Vial.
# El backend debe permanecer activo para ejecutar la revisión diaria.
PESV_AUTOMATIC_NOTIFICATIONS_ENABLED=true
PESV_NOTIFICATION_DAYS_BEFORE=15
PESV_NOTIFICATION_HOUR=7

ENABLE_REPORTE_SALIDA_FORM=false
ENABLE_DIGITAL_MEETING_MINUTE_FORM=false
BACKEND_PUBLIC_URL=http://localhost:5000
REPORTE_SALIDA_GESTION_HUMANA_EMAIL=adsolarte@unicesmag.edu.co
REPORTE_SALIDA_SST_EMAIL=gp.planeacion@unicesmag.edu.co
REPORTE_SALIDA_TEMPLATE_PATH=

# Responsables del flujo independiente de desplazamiento y viaticos.
# Los buzones institucionales se conservan aqui para poder cambiarlos sin recompilar.
VIATICOS_VICERRECTORIA_ACADEMICA_EMAIL=viceacad@unicesmag.edu.co
VIATICOS_VICERRECTORIA_INVESTIGACION_EMAIL=viceinvestiga@unicesmag.edu.co
VIATICOS_VICERRECTORIA_EVANGELIZACION_EMAIL=vicebien@unicesmag.edu.co
VIATICOS_VICERRECTORIA_FINANCIERA_EMAIL=jcnandar@unicesmag.edu.co
VIATICOS_VICERRECTORIA_FINANCIERA_INSTITUCIONAL_EMAIL=viceadfin@unicesmag.edu.co
VIATICOS_SST_EMAIL=seguridadysalud@unicesmag.edu.co
VIATICOS_RECTORIA_EMAIL=rectoria@unicesmag.edu.co
VIATICOS_GESTION_HUMANA_EMAIL=gestionhumana@unicesmag.edu.co
VIATICOS_TECNICO_CONTABLE_EMAIL=tecnico.viceadfin@unicesmag.edu.co
VIATICOS_TESORERIA_EMAIL=pagador@unicesmag.edu.co

# Gemini (Google Generative AI) - usado para sugerir indicadores a partir de la actividad.
# Obtener en https://aistudio.google.com/app/apikey (plan gratis: 1500 req/dia).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# IA para sugerir indicadores. Valores: web, local, auto, openai, gemini, ollama.
# OpenAI usa API billing independiente de ChatGPT Plus/Premium.
AI_PROVIDER=auto
AI_PROVIDER_TIMEOUT_MS=7000
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OLLAMA_URL=http://host.docker.internal:11434
OLLAMA_MODEL=llama3.1:8b

# Busqueda web para AI_PROVIDER=web. Valores: auto, tavily, serper, brave.
WEB_SEARCH_PROVIDER=auto
TAVILY_API_KEY=
SERPER_API_KEY=
BRAVE_SEARCH_API_KEY=
