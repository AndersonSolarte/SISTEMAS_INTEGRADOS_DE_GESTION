PUBLIC_APP_URL=http://10.10.192.8

DB_NAME=sgc_db
DB_USER=postgres
DB_PASSWORD=change_me
DB_PORT_HOST=5433
HOST_DB_HOST=db
HOST_DB_PORT=5432

BACKEND_PORT_HOST=5001
FRONTEND_PORT_HOST=8080

JWT_SECRET=change_me
JWT_EXPIRE=7d

GOOGLE_CLIENT_ID=
# Cloudflare Turnstile: clave publica para el frontend y secreta solo para el backend.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
INSTITUTIONAL_EMAIL_DOMAIN=unicesmag.edu.co
AUTH_GOOGLE_ONLY=true
GOOGLE_SHEETS_ID=
GOOGLE_SHEETS_TAB=

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

ENABLE_REPORTE_SALIDA_FORM=false
REACT_APP_ENABLE_REPORTE_SALIDA_FORM=false
BACKEND_PUBLIC_URL=http://10.10.192.8:5001
REPORTE_SALIDA_GESTION_HUMANA_EMAIL=sgc@unicesmag.edu.co
REPORTE_SALIDA_SST_EMAIL=gp.planeacion@unicesmag.edu.co
REPORTE_SALIDA_TEMPLATE_PATH=

SABER_PRO_PYTHON_TIMEOUT_MS=15000

REACT_APP_NAME=Sistema de Gestion de Calidad
REACT_APP_VERSION=1.0.0

# Respaldo automatico. La ruta real debe permanecer solo en el .env privado del servidor.
SIAC_BACKUP_DIR=
# 0 conserva todas las copias. Use un numero positivo solo si autoriza depuracion automatica.
SIAC_BACKUP_RETENTION_DAYS=0
SIAC_AUTOMATIC_BACKUP_ENABLED=true
SIAC_BACKUP_HOUR=18
SIAC_BACKUP_MINUTE=0
# Solo para emergencia: permite usar el script cron anterior en vez del monitor integrado.
SIAC_ALLOW_LEGACY_BACKUP_SCRIPT=false
